      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const base = \"http://localhost:8080/api/\";\r\npm.sendRequest(base + \"students/all\", (e, r) => r.json().forEach(s => pm.globals.set(\"student_\" + s.regNumber, s.id)));\r\npm.sendRequest(base + \"supervisors/all\", (e, r) => r.json().forEach(s => pm.globals.set(\"sup_\" + s.lastName, s.id)));\r\npm.sendRequest(base + \"shifts/all\", (e, r) => r.json().forEach(s => pm.globals.set(\"shift_\" + s.name, s.id)));\r\npm.sendRequest(base + \"room-bookings/all\", (e, r) => r.json().forEach(b => pm.globals.set(\"booking_\" + b.bookingDate + \"_\" + b.startHour, b.id)));\r\npm.globals.set(\"fakeId\", \"00000000-0000-0000-0000-000000000000\");"
            ]
          }
        }
